# Copie para .env e ajuste. O .env nunca vai para o git.
# Lido por src/handreplay/config.py (só variáveis de ambiente; nenhum valor secreto no código).

# Raiz dos dados offline (Fases 0 a 3). Aponte para fora do OneDrive.
HANDREPLAY_DADOS=./data

# Caminho do modelo ONNX. Na imagem da API, o Dockerfile define este valor.
HANDREPLAY_MODELO=./data/modelo/handreplay.onnx

# Limites do upload. O limite de tamanho pode baixar depois da medição da semana 5 (P2).
HANDREPLAY_MAX_MB=200
HANDREPLAY_MAX_DURACAO_S=90

# Threads do ONNX Runtime: igual à cota de vCPU do container.
HANDREPLAY_THREADS=2

# Origens aceitas pelo CORS, separadas por vírgula. Na publicação, só a origem do front,
# por exemplo https://<usuario>.github.io. Vazio recusa qualquer origem cruzada; "*" é recusado.
HANDREPLAY_ORIGENS=

# Porta HTTP do container.
PORT=8000

# Só se os repositórios do HF Hub forem privados (P3). Usado apenas no build,
# via `docker build --secret id=HF_TOKEN,env=HF_TOKEN`; nunca entra no código nem na imagem.
HF_TOKEN=
